{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with their personalized preferences and API settings",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "geminiApiKey": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "createdAt": { "type": "string" },
        "lastLoginAt": { "type": "string" }
      },
      "required": ["userId", "email"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Log of quant audits performed by users, storing input details and generated results",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "userPhoto": { "type": "string" },
        "inputType": { "type": "string", "enum": ["image", "text"] },
        "snippet": { "type": "string" },
        "topic": { "type": "string" },
        "subtopic": { "type": "string" },
        "myAnswerStatus": { "type": "string" },
        "markedAnswer": { "type": "string" },
        "isAbsurd": { "type": "string" },
        "cleanSolution": { "type": "string" },
        "hindiSolution": { "type": "string" },
        "auditSummary": { "type": "string" },
        "solutionShouldBeChanged": { "type": "string" },
        "questionShouldBeChanged": { "type": "string" },
        "correctedQuestion": { "type": "string" },
        "hindiQuestion": { "type": "string" },
        "createdAt": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["userId", "userEmail", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Stores user profiles, custom Gemini API keys, and roles."
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Stores every audit generated by any user for tracking, analytics, and admin inspection."
    }
  }
}
